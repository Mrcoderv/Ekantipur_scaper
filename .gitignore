```gitignore
# Virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# IDE settings
.idea/
.vscode/

# Environment files
.env

# Python version file
.python-version

# Logs
*.log

# Test / cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# Generated scraper output
output.json
```
